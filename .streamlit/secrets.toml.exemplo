# Copie o conteúdo para "Secrets" no Streamlit Cloud (Settings -> Secrets).
# NÃO coloque este ficheiro com chaves verdadeiras no GitHub.

# Onde ficam os dados (um ficheiro por casa)
[github]
token = "github_pat_COLE_AQUI_O_SEU_TOKEN"
repo = "o-seu-utilizador/despensa-dados"   # repositório PRIVADO onde ficam os dados
pasta = "casas"                            # casas/<id>.json
ramo = "main"

# Leitura automática de talões com o Google Gemini (gratuito; sem isto, só há registo à mão)
# Chave criada em https://aistudio.google.com/apikey (não precisa de cartão de crédito)
[ia]
chave_gemini = "AIza_COLE_AQUI_A_SUA_CHAVE"
modelo = "gemini-3.8-flash"   # se falhar ou esgotar a quota, tenta gemini-3.5-flash-lite e gemini-2.5-flash
limite_diario = 20            # talões lidos por casa e por dia (poupa a quota gratuita)
